# Copy to .env (gitignored). Loaded automatically by `pnpm harness`.
# Only needed for the GitHub experiment. Use fine-grained PATs scoped to a sandbox org.
GITHUB_SANDBOX_OWNER=
GITHUB_CONTROLLER_TOKEN=
GITHUB_AGENT_TOKEN=
# Tier 2 (github-rw) runs: pass this as GITHUB_AGENT_TOKEN for that command (see README).
GITHUB_AGENT_TOKEN_RW=
# GITHUB_HOST=api.github.com

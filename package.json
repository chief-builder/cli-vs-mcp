{
  "name": "cli-vs-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "CLI vs MCP experiments \u2014 Playwright and GitHub tool-surface comparison",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "harness": "node --env-file-if-exists=.env --import tsx harness/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "0.1.13",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "zod": "^4.6.5"
  }
}
